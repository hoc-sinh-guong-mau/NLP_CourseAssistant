% start S

# Entry rules only. The loader appends rules/*.fcfg in sorted order.
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> COURSE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> SCHEDULE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> TOPIC_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> ASSIGNMENT_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> DEADLINE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> RESOURCE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> INSTRUCTOR_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> CONTEXT_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> REQUEST_PREFIX[] RULE_LO_REQUEST[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] REQUEST_SUFFIX[]
