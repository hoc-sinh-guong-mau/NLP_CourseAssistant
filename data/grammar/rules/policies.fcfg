# policies: structural rules. Entity aliases belong in data/lexicon/.
RULE_LO_REQUEST[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> RULE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t]
RULE_LO_REQUEST[ENTITY=?e, INTENT='GET_LO', QTYPE=?q, TARGET='NONE'] -> LO_QUERY[ENTITY=?e, INTENT='GET_LO', QTYPE=?q]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='NONE'] -> RULE_PERSON[] RULE_PERMISSION_START[] RULE_ACTION[ENTITY=?e] RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='BTL01'] -> ASSIGNMENT[] RULE_PERMISSION_START[] RULE_ACTION[ENTITY=?e] RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='BTL01'] -> RULE_PERSON[] RULE_PERMISSION_START[] RULE_ACTION[ENTITY=?e] RULE_ASSIGNMENT_CONTEXT[] RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='NONE'] -> RULE_ACTION[ENTITY=?e] 'có' 'được' 'phép' RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='NONE'] -> 'việc' RULE_ACTION[ENTITY=?e] 'có' 'được' 'phép' RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='NONE'] -> USE_SUBJECT[ENTITY=?e] RULE_PERMISSION_START[] USE[] RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='BTL01'] -> USE_SUBJECT[ENTITY=?e] RULE_PERMISSION_START[] USE[] RULE_ASSIGNMENT_CONTEXT[] RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='NONE'] -> POLICY_NAME[] 'về' RULE_TOPIC[ENTITY=?e] POLICY_END[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='BTL01'] -> POLICY_NAME[] 'về' RULE_TOPIC[ENTITY=?e] RULE_ASSIGNMENT_CONTEXT[] POLICY_END[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='NONE'] -> RULE_SUBJECT[ENTITY=?e] 'được' 'quy' 'định' 'như' 'thế' 'nào'
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='NONE'] -> 'có' 'những' POLICY_NAME[] 'nào' 'về' RULE_TOPIC[ENTITY=?e]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='NONE'] -> RULE_PERSON[] OBLIGATION_START[] OBLIGATION_ACTION[ENTITY=?e] RULE_YESNO[]
RULE_QUERY[ENTITY=?e, INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='BTL01'] -> RULE_PERSON[] OBLIGATION_START[] OBLIGATION_ACTION[ENTITY=?e] RULE_ASSIGNMENT_CONTEXT[] RULE_YESNO[]
RULE_QUERY[ENTITY='OUT_OF_SCOPE', INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='NONE'] -> 'nếu' RULE_SYSTEM[] MISSING_EVIDENCE[] 'thì' NOANSWER_END[]
RULE_QUERY[ENTITY='OUT_OF_SCOPE', INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='NONE'] -> 'khi' RULE_SYSTEM[] MISSING_EVIDENCE[] NOANSWER_END[]
RULE_QUERY[ENTITY='OUT_OF_SCOPE', INTENT='GET_RULE', QTYPE='RULE_INFO', TARGET='NONE'] -> RULE_SYSTEM[] 'xử' 'lý' 'câu' 'hỏi' 'ngoài' 'phạm' 'vi' 'như' 'thế' 'nào'
RULE_QUERY[ENTITY='OUT_OF_SCOPE', INTENT='GET_RULE', QTYPE='PERMISSION', TARGET='NONE'] -> RULE_SYSTEM[] 'có' 'được' 'tự' 'tạo' 'câu' 'trả' 'lời' RULE_YESNO[]
