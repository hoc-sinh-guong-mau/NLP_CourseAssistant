# Copy to .env. Process environment and CLI options take precedence.
# Relative paths are resolved from COURSE_ROOT (repository root by default).
COURSE_OUTPUT_DIR=output
COURSE_DATABASE=data/db/course_assistant_normalized.sqlite3
COURSE_SAMPLE_LIMIT=100
COURSE_GENERATION_MAX_DEPTH=12
COURSE_GENERATION_CANDIDATE_FACTOR=20
COURSE_SQLITE_TIMEOUT=5
COURSE_UI_MAX_TURNS=50
COURSE_LOG_LEVEL=INFO

# Optional paths (defaults use repository or installed package resources):
# COURSE_ROOT=/absolute/path/to/project
# COURSE_DATA_DIR=data
# COURSE_MODELS_DIR=models
# COURSE_INPUT_DIR=input
# COURSE_RAW_DIR=data/raw
# COURSE_DB_DIR=data/db
# COURSE_GRAMMAR_PATH=models/grammar/syntax.fcfg
# COURSE_LEXICON_DIR=models/lexicon

# Streamlit settings also support normal STREAMLIT_* environment variables.
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
