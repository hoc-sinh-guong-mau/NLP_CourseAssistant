% start S

# Entry rules apply the same optional request framing to every query family.
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> REQUEST_PREFIX[] COURSE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> REQUEST_PREFIX[] SCHEDULE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> REQUEST_PREFIX[] TOPIC_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> REQUEST_PREFIX[] ASSIGNMENT_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> REQUEST_PREFIX[] DEADLINE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> REQUEST_PREFIX[] RESOURCE_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q] -> REQUEST_PREFIX[] INSTRUCTOR_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> REQUEST_PREFIX[] CONTEXT_QUERY[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] REQUEST_SUFFIX[]
S[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] -> REQUEST_PREFIX[] RULE_LO_REQUEST[ENTITY=?e, INTENT=?i, QTYPE=?q, TARGET=?t] REQUEST_SUFFIX[]
