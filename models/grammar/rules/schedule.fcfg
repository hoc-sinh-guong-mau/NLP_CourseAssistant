# schedule: structural rules. Entity aliases belong in models/lexicon/.
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_CONTENT', TARGET='NONE'] -> WEEK[ENTITY=?e] WEEK_CONTENT_WH[]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_CONTENT', TARGET='NONE'] -> WEEK[ENTITY=?e] WEEK_CONTENT_QUESTION[]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='CHAPTER_WEEK', TARGET='NONE'] -> CHAPTER[ENTITY=?e] CHAPTER_WEEK_QUESTION[]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='CHAPTER_WEEK', TARGET='NONE'] -> CHAPTER_WEEK_QUESTION[] 'của' CHAPTER[ENTITY=?e]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_CHAPTER', TARGET='NONE'] -> WEEK[ENTITY=?e] WEEK_CHAPTER_QUESTION[]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_CHAPTER', TARGET='NONE'] -> WEEK_CHAPTER_QUESTION[] 'của' WEEK[ENTITY=?e]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='TOPIC_WEEK', TARGET='NONE'] -> TOPIC_SECTION[ENTITY=?e] TOPIC_WEEK_WH[]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='TOPIC_WEEK', TARGET='NONE'] -> TOPIC_WEEK_WH[] 'của' TOPIC[ENTITY=?e]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='TOPICS_WEEK', TARGET=?t] -> TOPIC_SECTION[ENTITY=?e] 'và' TOPIC[ENTITY=?t] TOPIC_WEEK_WH[]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='TOPICS_WEEK', TARGET=?t] -> TOPIC_WEEK_WH[] 'của' TOPIC[ENTITY=?e] 'và' TOPIC[ENTITY=?t]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='PART_WEEKS', TARGET='NONE'] -> COURSE_PART[ENTITY=?e] 'học' 'vào' 'những' 'tuần' 'nào'
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='PART_WEEKS', TARGET='NONE'] -> 'những' 'tuần' 'nào' 'học' COURSE_PART[ENTITY=?e]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='PART_WEEKS', TARGET='NONE'] -> 'những' 'tuần' 'nào' 'học' 'về' COURSE_PART[ENTITY=?e]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='PART_WEEKS', TARGET='NONE'] -> COURSE_PART[ENTITY=?e] 'được' 'học' 'vào' 'những' 'tuần' 'nào'
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_ACTIVITY', TARGET='NONE'] -> WEEK[ENTITY=?e] 'có' 'hoạt' 'động' 'gì'
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_ACTIVITY', TARGET='NONE'] -> WEEK[ENTITY=?e] WEEK_ACTIVITY_QUESTION[]
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_MILESTONE', TARGET='NONE'] -> WEEK[ENTITY=?e] 'có' 'mốc' 'bài' 'tập' 'lớn' 'nào'
SCHEDULE_QUERY[ENTITY=?e, INTENT='GET_SCHEDULE', QTYPE='WEEK_MILESTONE', TARGET='NONE'] -> WEEK[ENTITY=?e] WEEK_MILESTONE_QUESTION[]

WEEK_CONTENT_QUESTION[] -> 'học' 'những' 'gì'
WEEK_CONTENT_QUESTION[] -> 'có' 'nội' 'dung' 'gì'
WEEK_CONTENT_QUESTION[] -> 'nội' 'dung' 'là' 'gì'
WEEK_CONTENT_QUESTION[] -> 'sẽ' 'học' 'gì'

CHAPTER_WEEK_QUESTION[] -> 'học' 'vào' 'tuần' 'nào'
CHAPTER_WEEK_QUESTION[] -> 'được' 'học' 'ở' 'tuần' 'nào'
CHAPTER_WEEK_QUESTION[] -> 'nằm' 'trong' 'tuần' 'nào'
CHAPTER_WEEK_QUESTION[] -> 'được' 'dạy' 'khi' 'nào'

WEEK_CHAPTER_QUESTION[] -> 'học' 'chương' 'nào'
WEEK_CHAPTER_QUESTION[] -> 'nội' 'dung' 'chương' 'nào'
WEEK_CHAPTER_QUESTION[] -> 'có' 'chủ' 'đề' 'gì'

WEEK_ACTIVITY_QUESTION[] -> 'có' 'những' 'hoạt' 'động' 'nào'
WEEK_ACTIVITY_QUESTION[] -> 'diễn' 'ra' 'hoạt' 'động' 'gì'
WEEK_ACTIVITY_QUESTION[] -> 'làm' 'gì'

WEEK_MILESTONE_QUESTION[] -> 'có' 'bài' 'tập' 'lớn' 'nào'
WEEK_MILESTONE_QUESTION[] -> 'có' 'deadline' 'nào'
WEEK_MILESTONE_QUESTION[] -> 'có' 'mốc' 'nào'
