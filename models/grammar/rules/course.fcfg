# Generalized ---------------------------------------------------------------------------------------------------------------------------

COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE=?q] -> COURSE[ENTITY=?e] COURSE_QUESTION[QTYPE=?q]
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE=?q] -> COURSE_QUESTION[QTYPE=?q] 'của' COURSE[ENTITY=?e]
