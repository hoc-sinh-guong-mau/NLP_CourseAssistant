# course: structural rules. Entity aliases belong in models/lexicon/.
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='CREDITS'] -> COURSE[ENTITY=?e] CREDIT_WH[]
COURSE_QUERY[ENTITY='CO3085', INTENT='GET_COURSE_INFO', QTYPE='MAIN_PARTS'] -> 'môn' 'học' MAIN_PARTS_WH[]
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='EXAM_DURATION'] -> EXAM[ENTITY=?e] DURATION_WH[]
COURSE_QUERY[ENTITY='CO3085', INTENT='GET_COURSE_INFO', QTYPE='COURSE_ID'] -> 'mã' 'môn' 'nlp' 'là' WHAT[]
COURSE_QUERY[ENTITY='CO3085', INTENT='GET_COURSE_INFO', QTYPE='COURSE_NAME'] -> 'co3085' 'là' 'môn' WHAT[]
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='MAIN_PARTS'] -> COURSE[ENTITY=?e] 'có' 'những' 'phần' 'chính' 'nào'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='SEMESTER'] -> COURSE[ENTITY=?e] 'thuộc' 'học' 'kỳ' 'nào'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='ECTS'] -> COURSE[ENTITY=?e] 'có' 'bao' 'nhiêu' 'ects'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='COURSE_TYPE'] -> COURSE[ENTITY=?e] 'thuộc' 'khối' 'kiến' 'thức' 'nào'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='DEPARTMENT'] -> COURSE[ENTITY=?e] 'thuộc' 'khoa' 'nào'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='FORMAT'] -> COURSE[ENTITY=?e] 'học' 'bao' 'nhiêu' 'tiết' 'mỗi' 'tuần'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='DURATION_WEEKS'] -> COURSE[ENTITY=?e] 'kéo' 'dài' 'bao' 'nhiêu' 'tuần'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='TOTAL_HOURS'] -> COURSE[ENTITY=?e] 'có' 'tổng' 'cộng' 'bao' 'nhiêu' 'giờ' 'học'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='LECTURE_HOURS'] -> COURSE[ENTITY=?e] 'có' 'bao' 'nhiêu' 'giờ' 'lý' 'thuyết'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='ASSIGNMENT_HOURS'] -> COURSE[ENTITY=?e] 'có' 'bao' 'nhiêu' 'giờ' 'bài' 'tập' 'lớn'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='SELF_STUDY_HOURS'] -> COURSE[ENTITY=?e] 'có' 'bao' 'nhiêu' 'giờ' 'tự' 'học'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='DESCRIPTION'] -> COURSE[ENTITY=?e] 'có' 'nội' 'dung' 'tổng' 'quan' 'gì'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='OBJECTIVES'] -> COURSE[ENTITY=?e] 'có' 'mục' 'tiêu' 'gì'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='ASSESSMENT'] -> COURSE[ENTITY=?e] 'được' 'đánh' 'giá' 'như' 'thế' 'nào'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='LEARNING_OUTCOMES'] -> COURSE[ENTITY=?e] 'có' 'những' 'chuẩn' 'đầu' 'ra' 'nào'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='ASSESSMENT'] -> 'cách' 'tính' 'điểm' 'của' COURSE[ENTITY=?e] 'là' WHAT[]
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='OBJECTIVES'] -> 'mục' 'tiêu' 'của' COURSE[ENTITY=?e] 'là' WHAT[]
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='EXAM_FORMAT'] -> EXAM[ENTITY=?e] 'thi' 'theo' 'hình' 'thức' 'nào'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='EXAM_OPEN_BOOK'] -> EXAM[ENTITY=?e] 'có' 'được' 'sử' 'dụng' 'tài' 'liệu' 'không'
COURSE_QUERY[ENTITY=?e, INTENT='GET_COURSE_INFO', QTYPE='ASSESSMENT_WEIGHT'] -> ASSESSMENT_ITEM[ENTITY=?e] 'chiếm' 'bao' 'nhiêu' 'phần' 'trăm' 'điểm'
