# topics: structural rules. Entity aliases belong in models/lexicon/.
# Find the chapter or chapters covering a topic or learning outcome.
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPIC', TARGET='NONE'] -> 'chương' TOPIC_CHAPTER_WH[] TOPIC_COVERAGE_CUE[] TOPIC[ENTITY=?e]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPIC', TARGET='NONE'] -> TOPIC_COVERAGE_CUE[] TOPIC[ENTITY=?e] CHAPTER_LOCATION_WH[]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPIC', TARGET='NONE'] -> 'ở' 'chương' 'nào' 'có' TOPIC[ENTITY=?e]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_LO', TARGET='NONE'] -> LO[ENTITY=?e] LO_COVERAGE_QUESTION[]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_LO', TARGET='NONE'] -> 'chương' TOPIC_CHAPTER_WH[] 'đáp' 'ứng' LO[ENTITY=?e]

TOPIC_CHAPTER_WH[] -> 'nào'
TOPIC_CHAPTER_WH[] -> 'những' 'chương' 'nào'
TOPIC_CHAPTER_WH[] -> 'chương' 'nào'
TOPIC_COVERAGE_CUE[] -> 'nói' 'về'
TOPIC_COVERAGE_CUE[] -> 'học' 'về'
TOPIC_COVERAGE_CUE[] -> 'đề' 'cập' 'đến'
TOPIC_COVERAGE_CUE[] -> 'trình' 'bày'
TOPIC_COVERAGE_CUE[] -> 'bao' 'gồm'
CHAPTER_LOCATION_WH[] -> 'được' 'học' 'ở' 'đâu'
CHAPTER_LOCATION_WH[] -> 'nằm' 'ở' 'chương' 'nào'
CHAPTER_LOCATION_WH[] -> 'thuộc' 'chương' 'nào'
LO_COVERAGE_QUESTION[] -> 'nằm' 'ở' 'chương' 'nào'
LO_COVERAGE_QUESTION[] -> 'được' 'đề' 'cập' 'trong' 'chương' 'nào'
LO_COVERAGE_QUESTION[] -> 'thuộc' 'chương' 'nào'

# Ask about chapter contents and methods.
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_CONTENT', TARGET='NONE'] -> CHAPTER[ENTITY=?e] CHAPTER_CONTENT_QUESTION[]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_METHODS', TARGET='NONE'] -> CHAPTER[ENTITY=?e] CHAPTER_METHODS_QUESTION[]
CHAPTER_CONTENT_QUESTION[] -> 'nói' 'về' WHAT[]
CHAPTER_CONTENT_QUESTION[] -> 'bao' 'gồm' 'những' 'nội' 'dung' 'gì'
CHAPTER_CONTENT_QUESTION[] -> 'dạy' 'những' 'gì'
CHAPTER_CONTENT_QUESTION[] -> 'học' WHAT[]
CHAPTER_CONTENT_QUESTION[] -> 'có' 'nội' 'dung' 'gì'
CHAPTER_METHODS_QUESTION[] -> 'có' 'những' 'phương' 'pháp' 'gì'
CHAPTER_METHODS_QUESTION[] -> 'đề' 'cập' 'đến' 'những' 'phương' 'pháp' 'nào'
CHAPTER_METHODS_QUESTION[] -> 'dạy' 'những' 'kỹ' 'thuật' 'nào'

# Check whether a chapter contains a topic; preserve topic as TARGET.
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_HAS_TOPIC', TARGET=?t] -> CHAPTER[ENTITY=?e] CHAPTER_TOPIC_QUESTION[ENTITY=?t]
CHAPTER_TOPIC_QUESTION[ENTITY=?t] -> 'có' 'liên' 'quan' 'đến' TOPIC[ENTITY=?t] 'không'
CHAPTER_TOPIC_QUESTION[ENTITY=?t] -> 'có' TOPIC[ENTITY=?t] 'không'
CHAPTER_TOPIC_QUESTION[ENTITY=?t] -> 'có' 'nội' 'dung' 'về' TOPIC[ENTITY=?t] 'không'
CHAPTER_TOPIC_QUESTION[ENTITY=?t] -> 'có' 'dạy' TOPIC[ENTITY=?t] 'không'
CHAPTER_TOPIC_QUESTION[ENTITY=?t] -> 'đề' 'cập' 'đến' TOPIC[ENTITY=?t] 'không'

# A chapter covering two topics binds both IDs.
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPICS', TARGET=?t] -> 'chương' TOPIC_CHAPTER_WH[] TOPIC_COVERAGE_CUE[] TOPIC[ENTITY=?e] 'và' TOPIC[ENTITY=?t]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPICS', TARGET=?t] -> TOPIC[ENTITY=?e] 'và' TOPIC[ENTITY=?t] CHAPTER_LOCATION_WH[]
