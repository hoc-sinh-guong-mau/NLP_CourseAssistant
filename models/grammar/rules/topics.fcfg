# topics: structural rules. Entity aliases belong in models/lexicon/.
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPIC', TARGET='NONE'] -> 'chương' 'nào' 'nói' 'về' TOPIC[ENTITY=?e]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPIC', TARGET='NONE'] -> 'chương' 'nào' 'học' 'về' TOPIC[ENTITY=?e]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPIC', TARGET='NONE'] -> TOPIC[ENTITY=?e] 'được' 'học' 'ở' 'đâu'
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_CONTENT', TARGET='NONE'] -> CHAPTER[ENTITY=?e] 'nói' 'về' WHAT[]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_CONTENT', TARGET='NONE'] -> CHAPTER[ENTITY=?e] 'học' WHAT[]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_METHODS', TARGET='NONE'] -> CHAPTER[ENTITY=?e] 'có' 'những' 'phương' 'pháp' 'gì'
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_HAS_TOPIC', TARGET=?t] -> CHAPTER[ENTITY=?e] 'có' 'liên' 'quan' 'đến' TOPIC[ENTITY=?t] 'không'
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='CHAPTER_HAS_TOPIC', TARGET=?t] -> CHAPTER[ENTITY=?e] 'có' TOPIC[ENTITY=?t] 'không'
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPICS', TARGET=?t] -> 'chương' 'nào' 'học' 'về' TOPIC[ENTITY=?e] 'và' TOPIC[ENTITY=?t]
TOPIC_QUERY[ENTITY=?e, INTENT='GET_TOPIC', QTYPE='FIND_CHAPTER_BY_TOPICS', TARGET=?t] -> 'chương' 'nào' 'nói' 'về' TOPIC[ENTITY=?e] 'và' TOPIC[ENTITY=?t]
