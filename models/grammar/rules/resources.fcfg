# resources: structural rules. Entity aliases belong in models/lexicon/.
# Category and topic searches.
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_CATEGORY'] -> RESOURCE_TOPIC[ENTITY=?e] RESOURCE_CATEGORY_QUESTION[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_CATEGORY'] -> RESOURCE_CATEGORY_QUESTION[] RESOURCE_TOPIC[ENTITY=?e]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_CATEGORY'] -> RESOURCE_TOPIC[ENTITY=?e] RESOURCE_CATEGORY_FOLLOWUP[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_CATEGORY'] -> RESOURCE_CATEGORY_QUESTION[] RESOURCE_TOPIC[ENTITY=?e] RESOURCE_WH[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_TOPIC'] -> TOPIC[ENTITY=?e] RESOURCE_TOPIC_QUESTION[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_TOPIC'] -> RESOURCE_TOPIC_QUESTION[] TOPIC[ENTITY=?e]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_CHAPTER'] -> CHAPTER[ENTITY=?e] RESOURCE_CHAPTER_QUESTION[]

RESOURCE_CATEGORY_QUESTION[] -> 'tài' 'liệu' 'tham' 'khảo' 'về'
RESOURCE_CATEGORY_QUESTION[] -> 'tài' 'liệu' 'nào' 'liên' 'quan' 'đến'
RESOURCE_CATEGORY_QUESTION[] -> 'tài' 'liệu' 'nào' 'thuộc' 'chủ' 'đề'
RESOURCE_CATEGORY_QUESTION[] -> 'có' 'những' 'tài' 'liệu' 'nào' 'về'
RESOURCE_CATEGORY_FOLLOWUP[] -> 'có' 'tài' 'liệu' 'nào'
RESOURCE_CATEGORY_FOLLOWUP[] -> 'có' 'tài' 'liệu' 'nào' 'không'
RESOURCE_CATEGORY_FOLLOWUP[] -> 'có' 'tài' 'liệu' 'tham' 'khảo' 'nào'
RESOURCE_CATEGORY_FOLLOWUP[] -> 'có' 'nguồn' 'tham' 'khảo' 'nào'
RESOURCE_CATEGORY_FOLLOWUP[] -> 'là' WHAT[]

RESOURCE_TOPIC_QUESTION[] -> 'tài' 'liệu' 'nào' 'nói' 'về'
RESOURCE_TOPIC_QUESTION[] -> 'tài' 'liệu' 'nào' 'liên' 'quan' 'đến'
RESOURCE_TOPIC_QUESTION[] -> 'có' 'tài' 'liệu' 'nào' 'về'
RESOURCE_TOPIC_QUESTION[] -> 'tài' 'liệu' 'về'
RESOURCE_TOPIC_QUESTION[] -> 'tài' 'liệu' 'của'
RESOURCE_TOPIC_QUESTION[] -> 'tài' 'liệu' 'nào' 'giúp' 'học'

RESOURCE_CHAPTER_QUESTION[] -> RESOURCE_NOUN[] RESOURCE_WH[]
RESOURCE_CHAPTER_QUESTION[] -> 'nên' 'đọc' 'tài' 'liệu' 'nào'
RESOURCE_CHAPTER_QUESTION[] -> 'có' 'tài' 'liệu' 'nào' 'để' 'học'

RESOURCE_NOUN[] -> 'tài' 'liệu'
RESOURCE_NOUN[] -> 'giáo' 'trình'
RESOURCE_NOUN[] -> 'sách'
RESOURCE_NOUN[] -> 'nguồn' 'tham' 'khảo'
RESOURCE_WH[] -> 'nào'
RESOURCE_WH[] -> 'là' 'gì'
RESOURCE_WH[] -> 'gồm' 'những' 'gì'
RESOURCE_WH[] -> 'có' 'những' 'gì'
RESOURCE_WH[] -> 'vậy'

# Course-wide reading lists.
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='TEXTBOOK_LIST'] -> COURSE[] COURSE_TEXTBOOK_QUESTION[]
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='TEXTBOOK_LIST'] -> COURSE_TEXTBOOK_QUESTION[] 'của' COURSE[]
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='TEXTBOOK_LIST'] -> 'giáo' 'trình' 'của' COURSE[] RESOURCE_WH[]
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='TEXTBOOK_LIST'] -> COURSE[] 'dùng' 'giáo' 'trình' 'nào'
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='REFERENCE_LIST'] -> COURSE[] COURSE_REFERENCE_QUESTION[]
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='REFERENCE_LIST'] -> COURSE_REFERENCE_QUESTION[] 'của' COURSE[]
COURSE_TEXTBOOK_QUESTION[] -> 'giáo' 'trình' 'là' RESOURCE_WH[]
COURSE_TEXTBOOK_QUESTION[] -> 'dùng' 'giáo' 'trình' 'nào'
COURSE_TEXTBOOK_QUESTION[] -> 'học' 'theo' 'giáo' 'trình' 'nào'
COURSE_REFERENCE_QUESTION[] -> 'tài' 'liệu' 'tham' 'khảo' RESOURCE_WH[]
COURSE_REFERENCE_QUESTION[] -> 'có' 'những' 'tài' 'liệu' 'tham' 'khảo' 'nào'
COURSE_REFERENCE_QUESTION[] -> 'nên' 'đọc' 'tài' 'liệu' 'nào'

# Metadata for a named resource.
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_AUTHOR'] -> RESOURCE_TITLE[ENTITY=?e] RESOURCE_AUTHOR_QUESTION[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_AUTHOR'] -> RESOURCE_AUTHOR_QUESTION[] RESOURCE_TITLE[ENTITY=?e]
RESOURCE_AUTHOR_QUESTION[] -> 'ai' 'là' 'tác' 'giả' 'của'
RESOURCE_AUTHOR_QUESTION[] -> 'tác' 'giả' 'là' 'ai'
RESOURCE_AUTHOR_QUESTION[] -> 'do' 'ai' 'viết'
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_YEAR'] -> RESOURCE_TITLE[ENTITY=?e] RESOURCE_YEAR_QUESTION[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_YEAR'] -> RESOURCE_YEAR_QUESTION[] RESOURCE_TITLE[ENTITY=?e]
RESOURCE_YEAR_QUESTION[] -> 'xuất' 'bản' 'năm' 'nào'
RESOURCE_YEAR_QUESTION[] -> 'được' 'xuất' 'bản' 'khi' 'nào'
RESOURCE_YEAR_QUESTION[] -> 'năm' 'xuất' 'bản' 'là' RESOURCE_WH[]
