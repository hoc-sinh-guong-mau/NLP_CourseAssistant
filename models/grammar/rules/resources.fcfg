# resources: structural rules. Entity aliases belong in models/lexicon/.
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_CATEGORY'] -> 'tài' 'liệu' 'tham' 'khảo' 'về' RESOURCE_TOPIC[ENTITY=?e] 'là' WHAT[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_CATEGORY'] -> 'tài' 'liệu' 'nào' 'liên' 'quan' 'đến' RESOURCE_TOPIC[ENTITY=?e]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_TOPIC'] -> 'tài' 'liệu' 'nào' 'nói' 'về' TOPIC[ENTITY=?e]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_TOPIC'] -> 'tài' 'liệu' 'nào' 'liên' 'quan' 'đến' TOPIC[ENTITY=?e]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_BY_TOPIC'] -> 'tài' 'liệu' 'của' TOPIC[ENTITY=?e] 'là' WHAT[]
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='TEXTBOOK_LIST'] -> 'giáo' 'trình' 'của' COURSE[] 'là' WHAT[]
RESOURCE_QUERY[ENTITY='CO3085', INTENT='GET_RESOURCE', QTYPE='REFERENCE_LIST'] -> 'tài' 'liệu' 'tham' 'khảo' 'của' COURSE[] 'là' WHAT[]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_AUTHOR'] -> 'ai' 'là' 'tác' 'giả' 'của' RESOURCE_TITLE[ENTITY=?e]
RESOURCE_QUERY[ENTITY=?e, INTENT='GET_RESOURCE', QTYPE='RESOURCE_YEAR'] -> RESOURCE_TITLE[ENTITY=?e] 'xuất' 'bản' 'năm' 'nào'
