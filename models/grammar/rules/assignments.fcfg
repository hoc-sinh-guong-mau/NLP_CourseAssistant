# Assignment entity may occur before or after its question phrase.
ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE=?q] -> ASSIGNMENT[ENTITY=?e] ASSIGNMENT_QUESTION[QTYPE=?q]
ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE=?q] -> ASSIGNMENT_QUESTION[QTYPE=?q] ASSIGNMENT[ENTITY=?e]

# Shared question focus, kept separate so question wording is not repeated.
WH_QUESTION[] -> 'gì'
WH_QUESTION[] -> 'nào'
WH_QUESTION[] -> 'những' 'gì'
WH_QUESTION[] -> 'ra' 'sao'
WH_QUESTION[] -> 'như' 'thế' 'nào'

