# assignments: structural rules. Entity aliases belong in models/lexicon/.
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='REQUIREMENTS'] -> ASSIGNMENT[] 'yêu' 'cầu' 'xây' 'dựng' WHAT_PLURAL[]
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='REQUIREMENTS'] -> ASSIGNMENT[] 'yêu' 'cầu' WHAT[]
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='REQUIREMENTS'] -> ASSIGNMENT[] 'có' 'những' 'yêu' 'cầu' WHAT[]
ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE='PART_INFO'] -> PART[ENTITY=?e] 'của' ASSIGNMENT[] 'là' WHAT[]
ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE='HAS_COMPONENT'] -> ASSIGNMENT[] 'có' 'phần' ASSIGNMENT_COMPONENT[ENTITY=?e] 'không'
ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE='HAS_COMPONENT'] -> ASSIGNMENT[] 'có' ASSIGNMENT_COMPONENT[ENTITY=?e] 'không'
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='TEAM_SIZE'] -> ASSIGNMENT[] 'nhóm' 'mấy' 'người'
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='TEAM_SIZE'] -> ASSIGNMENT[] 'làm' 'nhóm' 'bao' 'nhiêu' 'người'
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='TITLE'] -> ASSIGNMENT[] 'có' 'tên' 'là' 'gì'
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='GOAL'] -> ASSIGNMENT[] 'có' 'mục' 'tiêu' 'gì'
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='DOMAIN'] -> ASSIGNMENT[] 'thuộc' 'miền' 'dữ' 'liệu' 'nào'
ASSIGNMENT_QUERY[ENTITY='BTL01', INTENT='GET_ASSIGNMENT', QTYPE='OUTPUTS'] -> ASSIGNMENT[] 'cần' 'xuất' 'những' 'file' 'nào'
ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE='PART_OUTPUTS'] -> PART[ENTITY=?e] 'của' ASSIGNMENT[] 'cần' 'xuất' 'file' WHAT[]
ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE='PART_REQUIREMENTS'] -> PART[ENTITY=?e] 'của' ASSIGNMENT[] 'yêu' 'cầu' WHAT[]
ASSIGNMENT_QUERY[ENTITY='CO3085', INTENT='GET_ASSIGNMENT', QTYPE='ASSIGNMENT_LIST'] -> 'tôi' 'cần' 'hoàn' 'thành' 'những' 'bài' 'tập' 'nào'
