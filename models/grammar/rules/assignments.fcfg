ASSIGNMENT_QUERY[ENTITY=?e, INTENT='GET_ASSIGNMENT', QTYPE='ASSIGNMENT_LIST'] -> LIST_REQUEST[] LIST_ACTION[] ASSIGNMENT[ENTITY=?e] LIST_FOCUS[]
